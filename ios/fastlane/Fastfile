# Fastlane configuration for Brush Quest iOS.
#
# Lanes:
#   match_dev      Sync development certs + profiles (read-only)
#   match_release  Sync App Store certs + profiles (read-only)
#   beta           Upload an existing IPA to TestFlight (App Store
#                  Apple ID 6766338116). Build the IPA first via:
#                    flutter build ipa --release \
#                      --export-options-plist=ios/ExportOptions.plist
#                  Then run `fastlane beta` from ios/.
#
# Plan references: 1W-2 (this file), 2B-3/2B-4 (match), 2D-2/2D-3
# (TestFlight upload).

default_platform(:ios)

APP_STORE_APPLE_ID = "6766338116"
APP_IDENTIFIER = "com.brushquest.brushQuest"

platform :ios do
  desc "Sync development certs + profiles from match repo"
  lane :match_dev do
    match(type: "development", readonly: true)
  end

  desc "Sync App Store certs + profiles from match repo"
  lane :match_release do
    match(type: "appstore", readonly: true)
  end

  desc "Upload the IPA at ../build/ios/ipa/*.ipa to TestFlight."
  desc "Auth path:"
  desc "  - If APP_STORE_CONNECT_API_KEY_ID/ISSUER_ID/PRIVATE_KEY env vars are set,"
  desc "    use the API key (preferred for CI / Codemagic)."
  desc "  - Else, fall back to FASTLANE_USER + interactive 2FA prompt."
  lane :beta do
    if ENV["APP_STORE_CONNECT_API_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_filepath: ENV["APP_STORE_CONNECT_PRIVATE_KEY_PATH"],
        in_house: false,
      )
    end

    upload_to_testflight(
      app_identifier: APP_IDENTIFIER,
      apple_id: APP_STORE_APPLE_ID,
      ipa: "../build/ios/ipa/brush_quest.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end
